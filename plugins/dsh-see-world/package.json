{
  "name": "dsh-see-world",
  "version": "0.3.2",
  "description": "Let DSH see the world through a camera: score frames by how much the picture changed, keep only the ones that matter, pack them into one sheet, and wake the model when something actually happens. · 让 DSH 通过摄像头看世界。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "camera",
    "webcam",
    "vision",
    "llm",
    "ffmpeg",
    "realtime",
    "token-efficient",
    "multimodal"
  ],
  "author": "dsh-see-world contributors",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./capture": "./src/capture.js",
    "./session": "./src/session.js",
    "./sheet": "./src/sheet.js",
    "./analyze": "./src/analyze.js",
    "./loop": "./src/loop.js",
    "./tool-spec": "./src/tool-spec.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "icon.svg",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "hosttest": "node scripts/hosttest.mjs",
    "clienttest": "node scripts/clienttest.mjs",
    "paneltest": "node scripts/paneltest.mjs",
    "verify": "node scripts/clienttest.mjs && node scripts/paneltest.mjs && node scripts/hosttest.mjs --no-cam",
    "probe": "node scripts/probe-camera.mjs",
    "install-dev": "node scripts/install-dev.mjs",
    "check": "node scripts/install-dev.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
