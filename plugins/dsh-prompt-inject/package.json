{
  "name": "@local/dsh-prompt-inject",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inject ~/.dsh/prompt-inject.md as a system prompt section (works without dsh-purge-community).",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
